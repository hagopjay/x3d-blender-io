<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <component name="Geometry2D" level="2"/>
  </head>
  <Scene>
    <WorldInfo DEF="Info" title="Node board fixture" info='"first line" "second line"'>
      <MetadataSet name="board" reference="tests/node_board">
        <MetadataString name="author" value='"Ada"'/>
        <MetadataDouble name="ratio" value="0.5 1.25"/>
        <MetadataInteger name="count" value="3"/>
      </MetadataSet>
    </WorldInfo>
    <Transform DEF="Tri" translation="-3 0 0">
      <Shape>
        <Appearance><Material diffuseColor="1 1 1"/></Appearance>
        <IndexedFaceSet coordIndex="0 1 2 -1" colorPerVertex="true">
          <Coordinate point="0 0 0 1 0 0 0 1 0"/>
          <Color color="1 0 0 0 1 0 0 0 1"/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
    <Transform DEF="Zig" translation="0 -2 0">
      <Shape>
        <Appearance><Material emissiveColor="1 1 1"/></Appearance>
        <IndexedLineSet coordIndex="0 1 2 -1">
          <Coordinate point="0 0 0 1 1 0 2 0 0"/>
          <Color color="1 0 0 0 1 0 0 0 1"/>
        </IndexedLineSet>
      </Shape>
    </Transform>
    <Transform DEF="Rect" translation="0 0 0">
      <Shape>
        <Appearance><Material diffuseColor="0.2 0.4 0.8"/></Appearance>
        <Rectangle2D size="2 1"/>
      </Shape>
    </Transform>
    <Transform DEF="Circ" translation="3 0 0">
      <Shape>
        <Appearance><Material emissiveColor="1 1 0"/></Appearance>
        <Circle2D radius="0.75"/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
