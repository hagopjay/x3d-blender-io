<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Full" version="4.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema-instance" xsd:noNamespaceSchemaLocation="https://www.web3d.org/specifications/x3d-4.0.xsd">
  <head>
    <meta name="title" content="Node board gap batch 9: Fog, MetadataBoolean, MetadataFloat, TwoSidedMaterial and TextureBackground written back"/>
    <meta name="description" content="An EXPONENTIAL Fog; a TextureBackground with a sky and ground gradient, an ImageTexture front and PixelTexture top and bottom; a TwoSidedMaterial with separate back colours; MetadataBoolean and MetadataFloat on a Shape, a Material and a WorldInfo. The export must write each node back, with its type."/>
  </head>
  <Scene>
    <WorldInfo title="Batch 9">
      <MetadataFloat containerField="metadata" name="scale" value="0.5 1.25"/>
    </WorldInfo>
    <TextureBackground skyColor="0.1 0.2 0.6 0.5 0.7 0.9" skyAngle="1.2" groundColor="0.2 0.15 0.1">
      <ImageTexture containerField="frontTexture" url='"gap_batch_9_sky.png"'/>
      <PixelTexture containerField="topTexture" image="1 1 3 0x3366CC"/>
      <PixelTexture containerField="bottomTexture" image="1 1 3 0x332211"/>
    </TextureBackground>
    <Fog color="0.6 0.7 0.8" fogType="EXPONENTIAL" visibilityRange="40"/>
    <Transform DEF="Panel" translation="0 0 0">
      <Shape>
        <MetadataBoolean containerField="metadata" name="flags" value="true false true"/>
        <Appearance>
          <TwoSidedMaterial diffuseColor="0.8 0.2 0.2" backDiffuseColor="0.2 0.2 0.8" backShininess="0.6" backTransparency="0.25" separateBackColor="true">
            <MetadataFloat containerField="metadata" name="gloss" value="0.75"/>
          </TwoSidedMaterial>
        </Appearance>
        <IndexedFaceSet solid="false" coordIndex="0 1 2 3 -1">
          <Coordinate point="-1 -1 0 1 -1 0 1 1 0 -1 1 0"/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
    <Viewpoint description="Front" position="0 0 6"/>
  </Scene>
</X3D>
