<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Full" version="4.0">
  <head>
    <meta name="title" content="wired-script.x3d"/>
    <meta name="description" content="Two Scripts with every access type; ROUTEs into and out of their declared fields. Wired by the behaviour graph, never run."/>
  </head>
  <Scene>
    <Transform DEF="Lamp"><Shape><Sphere/><Appearance><Material DEF="LampMaterial"/></Appearance></Shape></Transform>
    <Transform DEF="Pad"><Shape><Box/></Shape><TouchSensor DEF="PadTouch"/></Transform>
    <TimeSensor DEF="Clock" cycleInterval="2"/>
    <PositionInterpolator DEF="Slide" key="0 1" keyValue="0 0 0 0 2 0"/>
    <Script DEF="Brain" directOutput="true" mustEvaluate="false"><field name="touched" type="SFTime" accessType="inputOnly"/><field name="fraction" type="SFFloat" accessType="inputOnly"/><field name="place" type="SFVec3f" accessType="outputOnly"/><field name="on" type="SFBool" accessType="inputOutput" value="true"/><field name="steps" type="SFInt32" accessType="initializeOnly" value="3"/><field name="names" type="MFString" accessType="outputOnly"/><field name="where" type="SFVec3d" accessType="inputOnly"/><field name="things" type="MFNode" accessType="inputOnly"/><field name="thing" type="SFNode" accessType="initializeOnly"/><![CDATA[ecmascript:
function touched(value, time) {
  if (value < 1 && time > 0 && a && b) { place = new SFVec3f(0, 1, 0); }
  var s = "x]]]]><![CDATA[> y";
}
]]></Script>
    <Script DEF="Remote" url='"remote.js" "https://example.org/remote.js"'><field name="go" type="SFBool" accessType="inputOnly"/><field name="colour" type="SFColor" accessType="outputOnly"/></Script>
    <ROUTE fromNode="PadTouch" fromField="touchTime" toNode="Brain" toField="touched"/>
    <ROUTE fromNode="PadTouch" fromField="touchTime" toNode="Clock" toField="startTime"/>
    <ROUTE fromNode="Clock" fromField="fraction_changed" toNode="Brain" toField="fraction"/>
    <ROUTE fromNode="Clock" fromField="fraction_changed" toNode="Slide" toField="set_fraction"/>
    <ROUTE fromNode="Brain" fromField="place" toNode="Lamp" toField="set_translation"/>
    <ROUTE fromNode="Slide" fromField="value_changed" toNode="Pad" toField="set_translation"/>
    <ROUTE fromNode="Brain" fromField="on_changed" toNode="Remote" toField="go"/>
    <ROUTE fromNode="Remote" fromField="colour" toNode="LampMaterial" toField="set_diffuseColor"/>
  </Scene>
</X3D>
