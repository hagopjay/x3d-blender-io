    <TexCoordDamper2D DEF="Damp2" tau="0.15" order="2" tolerance="0.01" initialValue="0 0  1 0  1 1  0 1" initialDestination="0 0  1 0  1 1  0 1"/>
    <BooleanFilter DEF="WatchChase3"/>
    <BooleanFilter DEF="WatchDamp3"/>
    <BooleanFilter DEF="WatchChase2"/>
    <BooleanFilter DEF="WatchDamp2"/>
    <!-- keeps X_ITE drawing between the clicks: a follower takes its step from the frame rate X_ITE has measured, which
