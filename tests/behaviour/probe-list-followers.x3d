    <CoordinateInterpolator2D DEF="Back2" key="0 1" keyValue="0.2 0  0.4 0  0.4 0.4  0 0.4   0.3 0  0.5 0  0.5 0.5  0 0.5"/>
    <CoordinateInterpolator DEF="Empty3" key="0 1" keyValue="0 0 0"/>
