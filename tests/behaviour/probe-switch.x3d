<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile="Immersive" version="4.0">
  <head>
    <component name="EventUtilities" level="1"/>
    <meta name="title" content="Behaviour simulator probe: Switch.whichChoice as a ROUTE end"/>
    <meta name="generator" content="hand written for tests/test_behaviour_sim.py"/>
  </head>
  <Scene>
    <NavigationInfo type='"NONE"'/>
    <Viewpoint position="0 0 10"/>
    <Transform DEF="Pad" translation="0 -2 0"><Shape><Appearance><Material diffuseColor="0.2 0.3 0.5"/></Appearance><Box size="8 0.2 4"/></Shape>
      <TouchSensor DEF="Touch"/>
    </Transform>
    <Switch DEF="Pick" whichChoice="0">
      <Transform DEF="Red" translation="-2 1 0"><Shape><Appearance><Material diffuseColor="0.8 0.2 0.2"/></Appearance><Box size="1 1 1"/></Shape></Transform>
      <Transform DEF="Green" translation="0 1 0"><Shape><Appearance><Material diffuseColor="0.2 0.8 0.2"/></Appearance><Sphere radius="0.6"/></Shape></Transform>
      <Transform DEF="Blue" translation="2 1 0"><Shape><Appearance><Material diffuseColor="0.2 0.2 0.8"/></Appearance><Cone/></Shape></Transform>
    </Switch>
    <Switch DEF="Echo" whichChoice="-1">
      <Shape><Sphere radius="0.1"/></Shape>
    </Switch>
    <TimeSensor DEF="Timer" cycleInterval="3"/>
    <IntegerSequencer DEF="Steps" key="0 0.25 0.5 0.75" keyValue="2 1 -1 5"/>
    <ROUTE fromNode="Touch" fromField="touchTime" toNode="Timer" toField="startTime"/>
    <ROUTE fromNode="Timer" fromField="fraction_changed" toNode="Steps" toField="set_fraction"/>
    <ROUTE fromNode="Steps" fromField="value_changed" toNode="Pick" toField="whichChoice"/>
    <ROUTE fromNode="Pick" fromField="whichChoice_changed" toNode="Echo" toField="whichChoice"/>
  </Scene>
</X3D>
