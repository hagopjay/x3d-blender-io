    <TimeSensor DEF="GaleClock" cycleInterval="20.0" loop="true" />
    <OrientationInterpolator DEF="GaleSpin" key="0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1" keyValue="0 1 0 0 0 1 0 0.7854 0 1 0 1.5708 0 1 0 2.35619 0 1 0 3.14159 0 1 0 3.92699 0 1 0 4.71239 0 1 0 5.49779 0 1 0 6.28319" />
    <TimeSensor DEF="PebbleClock" cycleInterval="9.0" loop="true" />
    <OrientationInterpolator DEF="PebbleSpin" key="0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1" keyValue="0 1 0 0 0 1 0 0.7854 0 1 0 1.5708 0 1 0 2.35619 0 1 0 3.14159 0 1 0 3.92699 0 1 0 4.71239 0 1 0 5.49779 0 1 0 6.28319" />
    <!-- flights: every body has its own TouchSensor -> TimeTrigger -> 3 s clock -> two interpolators -->
    <TimeTrigger DEF="SunGo" />
    <TimeSensor DEF="SunFlight" cycleInterval="3.0" />
    <PositionInterpolator DEF="SunPath" key="0 0.5 1" keyValue="0 3.6 10.6 0 4.9 8.9 0 2.7 7.2" />
    <OrientationInterpolator DEF="SunTurn" key="0 1" keyValue="-1 0 0 0.27 -1 0 0 0.2054" />
    <TimeTrigger DEF="VenusGo" />
    <TimeSensor DEF="VenusFlight" cycleInterval="3.0" />
    <PositionInterpolator DEF="VenusPath" key="0 0.5 1" keyValue="0 3.6 10.6 -0.98999 4.9 8.50038 -1.97999 2 6.40075" />
    <OrientationInterpolator DEF="VenusTurn" key="0 1" keyValue="-1 0 0 0.27 -0.36571 -0.92909 -0.05527 0.32252" />
    <TimeTrigger DEF="TerraGo" />
    <TimeSensor DEF="TerraFlight" cycleInterval="3.0" />
    <PositionInterpolator DEF="TerraPath" key="0 0.5 1" keyValue="0 3.6 10.6 1.1673 4.9 9.07358 2.33461 2 7.54716" />
    <OrientationInterpolator DEF="TerraTurn" key="0 1" keyValue="-1 0 0 0.27 -0.31657 0.94736 0.04785 0.3164" />
    <!-- the lever: pause every clock (the toggle starts true, so the first pull sends false) -->
    <Transform translation="-5 1.4 -3"><Shape><Appearance><PhysicalMaterial baseColor="0.78 0.55 0.22" metallic="1" roughness="0.32" /></Appearance><Cylinder radius="0.12" height="2.8" /></Shape></Transform>
    <Transform DEF="Lever" translation="-5 3.0 -3"><TouchSensor DEF="LeverTouch" description="Pause or resume the orrery" /><Shape><Appearance><PhysicalMaterial baseColor="0.78 0.55 0.22" metallic="1" roughness="0.32" /></Appearance><Box size="0.7 0.5 0.4" /></Shape><Transform translation="0 0.55 0" rotation="0 0 1 0.5"><Shape><Appearance><PhysicalMaterial baseColor="0.8 0.1 0.1" emissiveColor="0.3 0.02 0.02" /></Appearance><Cylinder radius="0.07" height="0.9" /></Shape></Transform><Transform translation="-0.22 1.0 0"><Shape><Appearance><PhysicalMaterial baseColor="0.9 0.2 0.2" emissiveColor="0.4 0.05 0.05" /></Appearance><Sphere radius="0.14" /></Shape></Transform></Transform>
    <BooleanFilter DEF="LeverPull" />
    <BooleanToggle DEF="Running" toggle="true" />
    <ROUTE fromNode="YearClock" fromField="fraction_changed" toNode="ChartPan" toField="set_fraction" />
    <ROUTE fromNode="ChartPan" fromField="value_changed" toNode="ChartSmooth" toField="set_destination" />
