    <Transform translation="0 5.5 -9.15"><Shape><Appearance><PhysicalMaterial baseColor="0.78 0.55 0.22" metallic="1" roughness="0.32" /></Appearance><Box size="14.4 0.14 0.2" /></Shape></Transform>
    <Transform translation="0 1.7 -9.15"><Shape><Appearance><PhysicalMaterial baseColor="0.78 0.55 0.22" metallic="1" roughness="0.32" /></Appearance><Box size="14.4 0.14 0.2" /></Shape></Transform>
    <!-- the year clock ticks the chart along like a ratchet: PositionInterpolator2D -> PositionChaser2D (glides each tick) -> TextureTransform -->
    <TimeSensor DEF="YearClock" cycleInterval="12.0" loop="true" />
    <PositionInterpolator2D DEF="ChartPan" key="0 0.08 0.12 0.33 0.37 0.58 0.62 0.83 0.87 1" keyValue="0 0  0 0  1.4 0  1.4 0  2.8 0.7  2.8 0.7  1.4 0.7  1.4 0.7  0 0  0 0" />
    <PositionChaser2D DEF="ChartSmooth" duration="1.5" initialDestination="0 0" initialValue="0 0" />
    <!-- the sun: a body you can click, and the light at the middle -->
    <Transform DEF="Sun" translation="0 1.2 0"><TouchSensor DEF="SunTouch" description="Fly to the sun" /><Shape><Appearance><PhysicalMaterial baseColor="1 0.7 0.2" emissiveColor="1 0.62 0.15" /></Appearance><Sphere radius="0.8" /></Shape><Transform translation="0 1.6 0"><Shape><Appearance><PhysicalMaterial baseColor="0.78 0.55 0.22" metallic="1" roughness="0.32" /></Appearance><Cone bottomRadius="0.7" height="1.7" /></Shape></Transform></Transform>
    <!-- planets on arms: each arm is turned by its own clock -->
    <Transform DEF="EmberArm" translation="0 1.2 0">
      <Transform translation="1.000 0 0"><Shape><Appearance><PhysicalMaterial baseColor="0.78 0.55 0.22" metallic="1" roughness="0.32" /></Appearance><Box size="2.000 0.045 0.045" /></Shape></Transform>
      <Transform DEF="Ember" translation="2.000 0 0">
        <Shape><Appearance><PhysicalMaterial baseColor="0.95 0.35 0.15" roughness="0.5" metallic="0.2" /></Appearance><Sphere radius="0.22" /></Shape>
      </Transform>
    </Transform>
    <Transform DEF="VenusArm" translation="0 1.2 0">
      <Transform translation="1.550 0 0"><Shape><Appearance><PhysicalMaterial baseColor="0.78 0.55 0.22" metallic="1" roughness="0.32" /></Appearance><Box size="3.100 0.045 0.045" /></Shape></Transform>
      <Transform DEF="Venus" translation="3.100 0 0">
        <TouchSensor DEF="VenusTouch" description="Fly to Venus" />
        <Shape><Appearance><PhysicalMaterial baseColor="0.90 0.75 0.40" roughness="0.5" metallic="0.2" /></Appearance><Sphere radius="0.34" /></Shape>
      </Transform>
    </Transform>
    <Transform DEF="TerraArm" translation="0 1.2 0">
      <Transform translation="2.150 0 0"><Shape><Appearance><PhysicalMaterial baseColor="0.78 0.55 0.22" metallic="1" roughness="0.32" /></Appearance><Box size="4.300 0.045 0.045" /></Shape></Transform>
      <Transform DEF="Terra" translation="4.300 0 0">
        <TouchSensor DEF="TerraTouch" description="Fly to Terra" />
        <Shape><Appearance><PhysicalMaterial baseColor="0.20 0.55 0.90" roughness="0.5" metallic="0.2" /></Appearance><Sphere radius="0.4" /></Shape>
        <Transform DEF="LunaArm">
          <Transform translation="0.800 0 0"><Shape><Appearance><PhysicalMaterial baseColor="0.85 0.85 0.9" roughness="0.7" /></Appearance><Sphere radius="0.12" /></Shape></Transform>
        </Transform>
      </Transform>
    </Transform>
    <Transform DEF="GaleArm" translation="0 1.2 0">
      <Transform translation="2.800 0 0"><Shape><Appearance><PhysicalMaterial baseColor="0.78 0.55 0.22" metallic="1" roughness="0.32" /></Appearance><Box size="5.600 0.045 0.045" /></Shape></Transform>
      <Transform DEF="Gale" translation="5.600 0 0">
        <Shape><Appearance><PhysicalMaterial baseColor="0.55 0.85 0.75" roughness="0.5" metallic="0.2" /></Appearance><Sphere radius="0.3" /></Shape>
        <Transform DEF="PebbleArm">
          <Transform translation="0.620 0 0"><Shape><Appearance><PhysicalMaterial baseColor="0.85 0.85 0.9" roughness="0.7" /></Appearance><Sphere radius="0.09" /></Shape></Transform>
        </Transform>
      </Transform>
    </Transform>
    <TimeSensor DEF="EmberClock" cycleInterval="4.0" loop="true" />
    <OrientationInterpolator DEF="EmberSpin" key="0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1" keyValue="0 1 0 0 0 1 0 0.7854 0 1 0 1.5708 0 1 0 2.35619 0 1 0 3.14159 0 1 0 3.92699 0 1 0 4.71239 0 1 0 5.49779 0 1 0 6.28319" />
    <TimeSensor DEF="VenusClock" cycleInterval="7.0" loop="true" />
    <OrientationInterpolator DEF="VenusSpin" key="0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1" keyValue="0 1 0 0 0 1 0 0.7854 0 1 0 1.5708 0 1 0 2.35619 0 1 0 3.14159 0 1 0 3.92699 0 1 0 4.71239 0 1 0 5.49779 0 1 0 6.28319" />
    <TimeSensor DEF="TerraClock" cycleInterval="12.0" loop="true" />
    <OrientationInterpolator DEF="TerraSpin" key="0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1" keyValue="0 1 0 0 0 1 0 0.7854 0 1 0 1.5708 0 1 0 2.35619 0 1 0 3.14159 0 1 0 3.92699 0 1 0 4.71239 0 1 0 5.49779 0 1 0 6.28319" />
    <TimeSensor DEF="LunaClock" cycleInterval="5.0" loop="true" />
