    <ROUTE fromNode="EmberClock" fromField="fraction_changed" toNode="EmberSpin" toField="set_fraction" />
    <ROUTE fromNode="EmberSpin" fromField="value_changed" toNode="EmberArm" toField="rotation" />
    <ROUTE fromNode="VenusClock" fromField="fraction_changed" toNode="VenusSpin" toField="set_fraction" />
    <ROUTE fromNode="VenusSpin" fromField="value_changed" toNode="VenusArm" toField="rotation" />
    <ROUTE fromNode="TerraClock" fromField="fraction_changed" toNode="TerraSpin" toField="set_fraction" />
    <ROUTE fromNode="TerraSpin" fromField="value_changed" toNode="TerraArm" toField="rotation" />
